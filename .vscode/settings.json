{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "files.exclude": {
    "**/__pycache__": true,
    ".pytest_cache": true
  },
  "search.exclude": { ".venv": true },

  "markdown.preview.breaks": false,
  "workbench.editorAssociations": { "DEMO.md": "vscode.markdown.preview.editor" },

  "rest-client.previewOption": "body",
  "rest-client.previewResponseInUntitledDocument": false,
  "rest-client.environmentVariables": {
    "$shared": { "baseUrl": "http://localhost:8080" }
  },
  "python.terminal.useEnvFile": true
}
