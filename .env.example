# --- Your GCP project (synthetic data only; no production systems) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Model calls -> global endpoint
GOOGLE_CLOUD_LOCATION=global
# confirm exact ID with scripts/verify_env.py
MODEL=gemini-3.8-flash
# optional; defaults to MODEL for the ADK rubric judge
JUDGE_MODEL=

# Memory Bank + Sessions -> regional Agent Engine
MEMORY_LOCATION=us-central1
# printed by scripts/setup_memory_bank.py
AGENT_ENGINE_ID=
# optional override for Memory Bank extraction model
MEMORY_GEN_MODEL=
# optional override for similarity search
EMBEDDING_MODEL=

# Unified scope: app_name=cx_unified, user_id=customer_id
APP_NAME=cx_unified

# local = offline in-memory services; vertex = Agent Platform Sessions + Memory Bank
BACKEND=vertex
LIVE_CONTEXT_TURNS=6

# --- Tokenized identity: HMAC key for customer tokens (use Cloud KMS / secret manager outside the PoC)
TOKEN_HMAC_KEY=
# demo only: return the one-time passcode in the step-up API response (set 0 for anything real)
DEMO_REVEAL_OTP=1

# --- Extraction policy: per_turn | salient | batched
EXTRACTION_POLICY=salient
EXTRACTION_BATCH_TURNS=6

# --- Partitions & quotas (client-side buckets, keep below your Memory Bank project quotas)
CONSUMER_READ_QPM=600
CONSUMER_WRITE_QPM=300
CONSUMER_EXTRACT_QPM=120
BUSINESS_READ_QPM=300
BUSINESS_WRITE_QPM=150
BUSINESS_EXTRACT_QPM=60
MAX_MEMORIES_PER_CUSTOMER=200
DAILY_WRITES_PER_CUSTOMER=50

# --- Cost model: ILLUSTRATIVE placeholders, replace with your rate card
PRICE_MODEL_INPUT_PER_M=0.30
PRICE_MODEL_OUTPUT_PER_M=2.50
PRICE_MB_GENERATE_PER_1K=0.25
PRICE_MB_RETRIEVE_PER_1K=0.25
PRICE_MB_STORED_PER_1K_MONTH=0.25
