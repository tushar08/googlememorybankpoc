# --- Your GCP project (synthetic data only; no production systems) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Model calls -> global endpoint
GOOGLE_CLOUD_LOCATION=global
# confirm exact ID with scripts/verify_env.py
MODEL=gemini-3.8-flash
# optional; defaults to MODEL for the ADK rubric judge
JUDGE_MODEL=

# Memory Bank + Sessions -> regional Agent Engine
MEMORY_LOCATION=us-central1
# printed by scripts/setup_memory_bank.py
AGENT_ENGINE_ID=
# optional override for Memory Bank extraction model
MEMORY_GEN_MODEL=
# optional override for similarity search
EMBEDDING_MODEL=

# Unified scope: app_name=cx_unified, user_id=customer_id
APP_NAME=cx_unified

# local = offline in-memory services; vertex = Agent Platform Sessions + Memory Bank
BACKEND=vertex
LIVE_CONTEXT_TURNS=6
